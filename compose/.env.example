# Busabase Premium 生产部署配置
# 复制为 .env 后修改：cp .env.example .env

# ── 必填：镜像 ───────────────────────────────────────────────────────────────
# Docker Hub 公开镜像。评估可用 :trial（有席位与时长上限），
# 签约客户用 :latest 或指定版本号。
BUSABASE_IMAGE=busabase/busabase-premium:latest
# 内网私有 registry 镜像源（可选）
# IMAGE_REGISTRY=registry.your-company.internal

# ── 必填：访问地址 ───────────────────────────────────────────────────────────
# 用户实际访问的地址。必须与浏览器地址栏一致，否则登录会话无法建立。
APP_URL=https://busabase.your-company.internal
APP_PORT=3000

# ── 必填：密钥（请全部替换）─────────────────────────────────────────────────
# 生成方式：openssl rand -hex 32
POSTGRES_USER=busabase
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
POSTGRES_DB=busabase
S3_ACCESS_KEY=busabase
S3_SECRET_KEY=CHANGE_ME_openssl_rand_hex_24
S3_BUCKET=busabase
# 用于签发登录会话，泄漏等同于任何人可伪造登录
BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32

# ── 可选 ─────────────────────────────────────────────────────────────────────
SYSTEM_ADMIN_EMAIL=admin@your-company.internal
SEAWEEDFS_VOLUME_LIMIT_MB=1024

# ── 对象存储的对外地址 ───────────────────────────────────────────────────────
# 浏览器会直接访问对象存储（上传用预签名 PUT，下载走跳转），所以这里必须填一个
# 浏览器解析得了的地址——填成 seaweedfs 这种容器内部名字，附件会全部传不上。
#
# 🚨 不能填 localhost。这个地址同时要被 app 容器用来签名和连接，而容器里的
#    localhost 指的是容器自己，不是 seaweedfs 服务，结果是每次上传都
#    ECONNREFUSED。填服务器的真实主机名或 IP（通常与 APP_URL 同主机）。
#    compose 里已配 extra_hosts，容器会把它解析回宿主机。
# 反向代理也要把这个端口一起转发。
S3_PUBLIC_HOST=busabase.your-company.internal
S3_PORT=8333
