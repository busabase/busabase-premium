# Busabase Premium — production deployment
# Copy to .env and edit: cp .env.example .env
#
# Prefer ./init.sh over editing this by hand. It fills in the secrets for you
# and keeps the two places that must agree on the object-storage credentials
# in sync — see the S3_PUBLIC_HOST note at the bottom for why that matters.

# ── Required: image ──────────────────────────────────────────────────────────
# Public on Docker Hub. The public :latest build is the same self-hosted
# edition for trial and licensed use — the licence you activate decides what
# the instance will do. Pin a version tag for reproducible upgrades.
BUSABASE_IMAGE=busabase/busabase-premium:latest
# Mirror into your own registry if this host cannot reach Docker Hub (optional)
# IMAGE_REGISTRY=registry.your-company.internal

# ── Required: address ────────────────────────────────────────────────────────
# The address users actually type. It must match what the browser shows, or
# sign-in sessions cannot be established.
APP_URL=https://busabase.your-company.internal
APP_PORT=3000

# ── Required: secrets (replace every one) ────────────────────────────────────
# Generate with: openssl rand -hex 32
POSTGRES_USER=busabase
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
POSTGRES_DB=busabase
S3_ACCESS_KEY=busabase
S3_SECRET_KEY=CHANGE_ME_openssl_rand_hex_24
S3_BUCKET=busabase
# Signs login sessions. Leaking this lets anyone forge a signed-in user.
BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32

# ── Optional ─────────────────────────────────────────────────────────────────
SYSTEM_ADMIN_EMAIL=admin@your-company.internal
SEAWEEDFS_VOLUME_LIMIT_MB=1024
# Comma-separated extra origins the sign-in endpoints trust in addition to
# APP_URL (e.g. keep an IP and a hostname valid during a migration).
# BETTER_AUTH_ADDITIONAL_ORIGINS=https://10.0.0.5:3000,https://busabase.company.internal
# Self-hosted defaults to no email verification so the first admin can sign in
# without an external mail provider. If delivery fails after enabling it, set
# this back to false and restart so the original administrator can sign in.
# EMAIL_VERIFICATION_REQUIRED=false

# Email delivery. Select one provider and configure its corresponding secret.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# POSTMARK_SERVER_TOKEN=...
# SENDGRID_API_KEY=SG...
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# EMAIL_FROM="Busabase <noreply@your-company.internal>"
# EMAIL_LOGO_URL=https://busabase.your-company.internal/logo.png

# Social login buttons appear only when both values for that provider exist.
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# ── Object storage: the address the browser uses ─────────────────────────────
# The browser fetches object storage directly — presigned PUT to upload,
# a redirect to download — so this has to be an address the browser can
# resolve. Put a container-internal name like `seaweedfs` here and every
# attachment upload fails.
#
# 🚨 Not localhost. This same address is used by the app container to sign
#    and connect, and inside a container localhost means the container
#    itself, not the seaweedfs service — every upload then fails with
#    ECONNREFUSED. Use the server's real hostname or IP (usually the same
#    host as APP_URL). The compose file sets extra_hosts so the container
#    resolves it back to the Docker host.
# Forward this port through your reverse proxy as well.
S3_PUBLIC_HOST=busabase.your-company.internal
S3_PORT=8333
